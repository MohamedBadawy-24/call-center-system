    "test:exports": "jest --runInBand --forceExit tests/exports.test.js",
    "test:rbac": "jest --runInBand --forceExit tests/rbac.test.js",
    "test:ws": "jest --runInBand --forceExit tests/websocket.test.js",
    "test:ui": "cd admin-ui && npm run test",
    "db:migrate": "node scripts/migrate-indexes.js",
    "db:seed": "node scripts/seed-admin.js"
